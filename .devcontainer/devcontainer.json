{
  "name": "THUNER Claude Sandbox",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "remoteUser": "thuner",
  "workspaceFolder": "/workspace",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=cached",
  "mounts": [
    "source=${localEnv:HOME}/.claude,target=/home/thuner/.claude,type=bind,consistency=cached",
    "source=${localEnv:HOME}/.claude.json,target=/home/thuner/.claude.json,type=bind,consistency=cached",
    "source=thuner-pixi,target=${containerWorkspaceFolder}/.pixi,type=volume"
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python"
      ]
    }
  },
  "postCreateCommand": "sudo chown thuner:thuner ${containerWorkspaceFolder}/.pixi && pixi install"
}
